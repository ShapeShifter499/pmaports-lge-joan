From: Lance <Gero3977@gmail.com>
Subject: [PATCH] Serve the calibration groups and answer group writes

On the LG V30 the sensor DSP reads five groups that were not in the map,
2500, 2610, 2970, 2980 and 2990, and gets a failure for each. It also
sends group writes (message 0x05) that were dropped without a reply.
Group 2500 holds the gyro calibration settings and 2970 the magnetometer
calibration settings, so the DSP's fused outputs ran uncalibrated.

Add those groups and the written groups 2691 and 3050, with layouts
taken from the item and group tables in LG's sensors.qti. The tables
were checked against this map (64 of 68 groups identical, sizes all
equal) and against the phone's own sns.reg, whose size matches exactly.

Answer group writes and keep the values for the current boot. Log
messages that are still unhandled, and line-buffer stdout so the journal
does not lose requests.

Signed-off-by: Lance <Gero3977@gmail.com>
Assisted-by: Claude-Code:claude-opus-5-5
---
--- a/main.c
+++ b/main.c
@@ -129,6 +129,79 @@
 	return ret;
 }
 
+int handle_group_write(int sock, struct qrtr_packet *packet, unsigned long *registry)
+{
+	unsigned int txn_id;
+	struct sns_reg_group_write_req request = { };
+	struct sns_reg_group_write_resp response = { };
+	const struct group *group = NULL;
+	size_t index = 0;
+	size_t size = 0;
+	struct key key;
+	struct qrtr_packet out_packet;
+	int ret;
+
+	ret = qmi_decode_message(
+				&request,
+				&txn_id,
+				packet,
+				QMI_REQUEST,
+				SNS_REG_GROUP_WRITE_MSG_ID,
+				sns_reg_group_write_req_ei
+			);
+	if (ret < 0) {
+		fprintf(stderr, "Failed to decode write request\n");
+		return ret;
+	}
+
+	group = group_by_id(request.id);
+
+	printf("Write to group %04d, %d bytes%s\n", request.id, request.data_len,
+	       !group ? " unmapped!" : "");
+
+	if (!group) {
+		response.result = QMI_RESULT_FAILURE_V01;
+	} else {
+		response.result = QMI_RESULT_SUCCESS_V01;
+
+		/* Values are kept for this boot only */
+		while ((key = group->keys[index++]).len &&
+		       size + key.len <= request.data_len) {
+			if (key.id != -1) {
+				registry[key.id] = 0;
+				memcpy(&registry[key.id], request.data + size, key.len);
+			}
+
+			size += key.len;
+		}
+	}
+
+	out_packet.data = malloc(BUFFER_LEN);
+	out_packet.data_len = BUFFER_LEN;
+
+	ret = qmi_encode_message(
+		&out_packet,
+		QMI_RESPONSE,
+		SNS_REG_GROUP_WRITE_MSG_ID,
+		txn_id,
+		&response,
+		sns_reg_group_write_resp_ei
+	);
+	if (ret < 0) {
+		fprintf(stderr, "Failed to encode write response: %d\n", ret);
+		goto out;
+	}
+
+	ret = qrtr_sendto(sock, packet->node, packet->port, out_packet.data, out_packet.data_len);
+	if (ret)
+		fprintf(stderr, "Failed to send write response: %d\n", ret);
+
+out:
+	free(out_packet.data);
+
+	return ret;
+}
+
 int main(int argc, const char **argv)
 {
 	int fd;
@@ -143,6 +216,9 @@
 	struct sns_reg_group_req request;
 	int ret;
 
+	/* Logs go to the journal, so do not sit in a block buffer */
+	setvbuf(stdout, NULL, _IOLBF, 0);
+
 	fd = open("/etc/sns-reg.d/registry.conf", O_RDONLY);
 	if (fd < 0) {
 		fprintf(stderr, "Failed to open registry: %s\n", strerror(errno));
@@ -198,6 +274,10 @@
 
 		if (header->msg_id == SNS_REG_GROUP_MSG_ID)
 			handle_group_request(sock, &packet, registry);
+		else if (header->msg_id == SNS_REG_GROUP_WRITE_MSG_ID)
+			handle_group_write(sock, &packet, registry);
+		else
+			printf("Unhandled message 0x%x\n", header->msg_id);
 	}
 
 	return 0;
