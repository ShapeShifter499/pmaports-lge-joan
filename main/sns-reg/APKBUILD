# Maintainer: Yassine Oudjana (Tooniis) <y.oudjana@protonmail.com>
pkgname=sns-reg
pkgver=0_git20250706
pkgrel=1
pkgdesc="Qualcomm Sensor Registry server"
url="https://gitlab.com/msm8996-mainline/sns-reg"
arch="armv7 aarch64"
license="GPL-3.0-or-later"
makedepends="scons qrtr-dev"
subpackages="$pkgname-openrc $pkgname-systemd"
_commit="4d238e5f0baba3fb77456fe2bffbf8e8f18a71a0"
source="
	$pkgname-$_commit.tar.gz::$url/-/archive/$_commit/$pkgname-$_commit.tar.gz
	0001-map-add-joan-orientation-groups.patch
	0002-serve-calibration-groups-and-writes.patch
	$pkgname.service
"
builddir="$srcdir/$pkgname-$_commit"
options="!check"

build() {
	scons
}

package() {
	install -Dm755 "$pkgname" "$pkgdir/usr/sbin/$pkgname"
	install -Dm755 "$pkgname.initd" "$pkgdir/etc/init.d/$pkgname"
	install -Dm644 "$srcdir/$pkgname.service" \
		"$pkgdir/usr/lib/systemd/system/$pkgname.service"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

