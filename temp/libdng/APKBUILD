# Forked from Alpine (community/libdng 0.2.2-r0): packed DNG strips were
# written at the v4l2 stride, so a 2-byte row pad sheared every scanline.
# Contributor: Martijn Braam <martijn@brixit.nl>
# Maintainer: Martijn Braam <martijn@brixit.nl>
pkgname=libdng
_pkgver=0.2.2
pkgver=9999$_pkgver
pkgrel=0
pkgdesc="Interface library between libtiff and the world to make sure the output is valid DNG"
url="https://gitlab.com/megapixels-org/libdng"
arch="all !s390x" # Libtiff does weird things on s390x
license="MIT"
makedepends="cmake linux-headers meson tiff-dev scdoc"
subpackages="$pkgname-doc $pkgname-dev $pkgname-utils"
source="
	0001-write-repacked-rows-at-tight-pitch.patch
	https://gitlab.com/megapixels-org/libdng/-/archive/$_pkgver/libdng-$_pkgver.tar.gz
	"
builddir="$srcdir/libdng-0.2.2"

build() {
	abuild-meson . output
	meson compile -C output
}

check() {
	meson test -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

utils() {
	pkgdesc="DNG manipulation utlities using libdng"
	amove usr/bin
}

sha512sums="
837d23ad3622c5067928dad98b2e7bb3254a841bc3a6534918f892160c3b25c5087aa6076beac761c1729ba948d95c721ecf67775c60436ff3b3b616bf4df32e  0001-write-repacked-rows-at-tight-pitch.patch
c12a9dbab050e37a5af8ad82efa0dbb520c357582d3922bc4307d678d986b02cc0f1210b249ad09be1b2366116033ef70c3fa9c4c5d3eda044a9458032df83a0  libdng-0.2.2.tar.gz
"
