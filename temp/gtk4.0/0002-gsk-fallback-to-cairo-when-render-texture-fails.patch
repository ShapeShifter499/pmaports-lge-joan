   texture = GSK_RENDERER_GET_CLASS (renderer)->render_texture (renderer, root, viewport);
 
+  if (texture == NULL && !GSK_IS_CAIRO_RENDERER (renderer))
+    {
+      /* The GPU renderers can fail to produce a texture, for example when
+       * their GL context cannot be made current.  Fall back to a temporary
+       * cairo renderer so callers still get a texture instead of nothing.
+       */
+      GskRenderer *fallback = gsk_cairo_renderer_new ();
+      GdkDisplay *display = priv->surface
+                              ? gdk_surface_get_display (priv->surface)
+                              : NULL;
+
+      if (gsk_renderer_realize_for_display (fallback, display, NULL))
+        {
+          texture = gsk_renderer_render_texture (fallback, root, viewport);
+          gsk_renderer_unrealize (fallback);
+        }
+      g_object_unref (fallback);
+    }
+
   return texture;
