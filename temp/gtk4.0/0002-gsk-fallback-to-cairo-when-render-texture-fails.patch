+/* Returns FALSE when the GL renderer could not make its context current.
+ * The GDK make_current wrapper only warns on failure and leaves the thread
+ * without a current context; every later GL use would then dereference
+ * NULL and crash (seen on GLES-only devices with no Vulkan fallback).
+ */
+static gboolean
+gsk_gpu_renderer_ensure_current (GskGpuRenderer *self)
+{
+  gsk_gpu_renderer_make_current (self);
+
+  return !GDK_IS_GL_CONTEXT (gsk_gpu_renderer_get_context (self)) ||
+         gdk_gl_context_get_current () != NULL;
+}
+
 static gboolean
 gsk_gpu_renderer_dmabuf_downloader_download (GdkDmabufDownloader   *downloader,
                                              GdkDmabufTexture      *texture,
@@ -153,7 +168,11 @@
   timestamp = g_get_monotonic_time ();
   gsk_gpu_device_maybe_gc (priv->device, timestamp);
 
-  gsk_gpu_renderer_make_current (self);
+  if (!gsk_gpu_renderer_ensure_current (self))
+    {
+      gsk_gpu_renderer_restore_current (self, previous);
+      return FALSE;
+    }
 
   frame = gsk_gpu_renderer_get_frame (self);
 
@@ -362,7 +381,11 @@
 
           /* Let's GC like a madman, we draw oversized stuff and don't want to OOM */
