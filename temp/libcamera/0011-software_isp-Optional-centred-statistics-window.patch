 			      const std::vector<std::reference_wrapper<const StreamConfiguration>> &outputCfgs,
-			      bool ccmEnabled) = 0;
+			      bool ccmEnabled, uint32_t statsWindowPercent) = 0;
 
 	virtual std::vector<PixelFormat> formats(PixelFormat inputFormat) = 0;
 
@@ -87,6 +87,30 @@ private:
 	virtual Size patternSize(PixelFormat inputFormat) = 0;
 
 protected:
+	/*
+	 * Compute the statistics window for the processed window \a window and
+	 * the tuning-provided \a percent. A percent of 0 (or of 100 and above)
+	 * selects the whole processed window, which is the upstream behaviour.
+	 *
+	 * Otherwise the window is restricted to a centred \a percent of the
+	 * processed window. Lens shading biases whole-frame statistics, so
+	 * cameras whose lenses shade in opposite directions disagree about the
+	 * colour temperature of the same scene; ignoring the frame edges where
+	 * the shading is strongest removes most of that disagreement.
+	 */
+	static Rectangle statsWindow(const Rectangle &window, unsigned int percent)
+	{
+		if (percent == 0 || percent >= 100)
+			return Rectangle(window.size());
+
+		unsigned int width = window.width * percent / 100;
+		unsigned int height = window.height * percent / 100;
+
+		return Rectangle(window.x + (window.width - width) / 2,
+				  window.y + (window.height - height) / 2,
+				  width, height);
+	}
+
 	void dmaSyncBegin(std::vector<DmaSyncer> &dmaSyncers, FrameBuffer *input, FrameBuffer *output);
 	static bool isStandardBayerOrder(BayerFormat::Order order);
 };
