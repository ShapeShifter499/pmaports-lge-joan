# Forked from Alpine (community/libmegapixels 0.2.3-r0): qcom-camss IMMUTABLE
# sensor links need their flag preserved in MEDIA_IOC_SETUP_LINK (joan).
maintainer="Stefan Hansson <newbyte@postmarketos.org>"
pkgname=libmegapixels
_pkgver=0.2.3
pkgver=9999$_pkgver
pkgrel=0
pkgdesc="Device abstraction for the Megapixels application"
url="https://libme.gapixels.me"
arch="all"
license="GPL-3.0-or-later"
builddir="$srcdir/libmegapixels-$_pkgver"
makedepends="libconfig-dev linux-headers meson"
subpackages="$pkgname-dev"
source="
	0001-setup-link-preserve-immutable.patch
	https://gitlab.com/megapixels-org/libmegapixels/-/archive/$_pkgver/libmegapixels-$_pkgver.tar.gz"

build() {
	abuild-meson \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

