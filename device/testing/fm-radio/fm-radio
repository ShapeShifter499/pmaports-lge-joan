def find_fm_capture():
    """ALSA device string of the FM capture PCM, or None.

    $FM_RADIO_CAPTURE wins; otherwise the first capture PCM whose name
    contains "FM" in /proc/asound/pcm ("00-07: FM Radio (*) : : capture 1").
    """
    dev = os.environ.get("FM_RADIO_CAPTURE")
    if dev:
        return dev
    try:
        with open("/proc/asound/pcm") as f:
            for line in f:
                ident, _, rest = line.partition(":")
                if "FM" in rest and "capture" in rest:
                    card, _, pcm = ident.strip().partition("-")
                    return f"hw:{int(card)},{int(pcm)}"
    except (OSError, ValueError):
        pass
    return None


def _percent(sink):
    """Loudest channel of a sink's volume in percent, as the system shows it."""
    try:
        return max(int(ch["value_percent"].rstrip("%"))
                   for ch in sink["volume"].values())
    except (KeyError, ValueError, AttributeError, TypeError):
        return None


def query_outputs():
    """([(sink name, description)], {sink name: (volume %, muted)},
    default sink name) from the sound server; empty if unreachable."""
    try:
        out = subprocess.run(["pactl", "-f", "json", "list", "sinks"],
                             capture_output=True, timeout=5, check=True).stdout
        sinks = [s for s in json.loads(out) if s.get("name") != "auto_null"]
        default = subprocess.run(["pactl", "get-default-sink"],
                                 capture_output=True, timeout=5,
                                 text=True).stdout.strip()
        return ([(s["name"], s.get("description") or s["name"])
                 for s in sinks],
                {s["name"]: (_percent(s), bool(s.get("mute"))) for s in sinks},
                default)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        return [], {}, ""


def list_outputs():
    """[(sink name, description)] from the sound server, [] if unreachable."""
    return query_outputs()[0]


def set_output_volume(sink, percent):
    try:
        subprocess.run(["pactl", "set-sink-volume", sink, f"{percent}%"],
                       timeout=5, check=True)
    except (OSError, subprocess.SubprocessError):
        pass


class SoundServerWatch:
    """Call back (on the main loop) when outputs or their volumes change."""

    def __init__(self, callback):
        self.callback = callback
        self.proc = None
        self.pending = False
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        try:
            self.proc = subprocess.Popen(
                ["pactl", "subscribe"], stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL, text=True)
        except OSError:
            return
        for line in self.proc.stdout:
            # sink volume and mute, sinks coming and going, default sink
            if (" on sink #" in line or " on server" in line) \
                    and not self.pending:
                self.pending = True
                GLib.timeout_add(150, self._fire)

    def _fire(self):
        self.pending = False
        self.callback()
        return GLib.SOURCE_REMOVE

    def stop(self):
        if self.proc:
            self.proc.terminate()


def _move_own_stream(sink):
    """Move this process's playback stream to another output."""
    try:
        out = subprocess.run(["pactl", "-f", "json", "list", "sink-inputs"],
                             capture_output=True, timeout=5, check=True).stdout
        pid = str(os.getpid())
        moved = False
        for si in json.loads(out):
            if si.get("properties", {}).get("application.process.id") == pid:
                subprocess.run(["pactl", "move-sink-input", str(si["index"]),
                                sink], timeout=5, check=True)
                moved = True
        return moved
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        return False


