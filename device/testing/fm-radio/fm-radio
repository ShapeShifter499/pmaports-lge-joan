class RdsLog:
    """RDS written next to a recording: a readable log and/or raw blocks.

    Text: one line per change, stamped with the position in the recording.
    Raw: the V4L2 RDS block stream exactly as the tuner delivered it,
    three bytes per block (data LSB, data MSB, block number + error flags),
    including blocks with errors.
    """

    def __init__(self, base, text, raw, khz):
        self.started = time.monotonic()
        self.text = open(base + ".rds.txt", "w") if text else None
        self.raw = open(base + ".rds", "wb") if raw else None
        self.last = {}
        self.pending = {}
        self.next_signal = 0.0
        self.line(f"Recording started {time.strftime('%Y-%m-%d %H:%M:%S %z')}")
        self.tuned(khz)

    def line(self, text):
        if not self.text:
            return
        t = time.monotonic() - self.started
        self.text.write(f"[{int(t // 60):02d}:{t % 60:04.1f}] {text}\n")
        self.text.flush()

    def tuned(self, khz):
        self.last = {}
        self.pending = {}
        self.line(f"Tuned {khz / 1000:.1f} MHz")

    def blocks(self, data):
        if self.raw and data:
            self.raw.write(data)

    def _settled(self, key, value):
        """True once a value has been the same on two polls in a row and
        differs from what was last logged (texts arrive in pieces)."""
        if value == self.last.get(key):
            self.pending.pop(key, None)
            return False
        if self.pending.get(key) != value:
            self.pending[key] = value
            return False
        self.last[key] = value
        return True

    def update(self, rds, signal_pct, stereo):
        if not self.text:
            return
        if rds.pi is not None and self._settled("pi", rds.pi):
            self.line(f"Programme ID {rds.pi:04X}")
        if rds.pty is not None and self._settled("pty", rds.pty):
            self.line(f"Programme type {rds.pty} "
                      f"(RBDS: {PTY_RBDS[rds.pty] or '-'}, "
                      f"RDS: {PTY_RDS[rds.pty]})")
        if rds.tp is not None and self._settled("tp", (rds.tp, rds.ta)):
            self.line(f"Traffic programme {'yes' if rds.tp else 'no'}, "
                      f"announcement {'on' if rds.ta else 'off'}")
        if rds.name and self._settled("ps", rds.name):
            self.line(f"Station name: {rds.name}")
        if rds.text and self._settled("rt", rds.text):
            self.line(f"Radiotext: {rds.text}")
        if rds.clock and self._settled("ct", rds.clock):
            self.line(f"Clock time: {rds.clock}")
        now = time.monotonic()
        if now >= self.next_signal:
            self.next_signal = now + 10
            self.line(f"Signal {signal_pct:.0f}%, "
                      f"{'stereo' if stereo else 'mono'}")

    def close(self):
        self.line("Recording stopped")
        for f in (self.text, self.raw):
            if f:
                f.close()
        self.text = self.raw = None


