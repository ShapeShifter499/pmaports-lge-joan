class Audio:
    """Capture the tuner's audio, play it to one output, optionally record.

    The capture feeds a tee with two fixed branches: one plays through the
    sound server, the other ends in a tap. A recording is a small pipeline
    of its own (encoder, container, file) fed from the tap, with timestamps
    counted from its own first sample. Nothing is added to or removed from
    the live pipeline, so starting, stopping and switching outputs cannot
    disturb each other.
    """

    RATE = 48000
    CAPS = "audio/x-raw,format=S16LE,rate=48000,channels=2,layout=interleaved"

    def __init__(self, on_error):
        self.on_error = on_error
        self.pipeline = None
        self.sink = None
        self.lock = threading.Lock()
        self.rec = None        # (pipeline, appsrc, path, done callback)
        self.rec_frames = 0
        self.rec_started = 0.0

    @property
    def playing(self):
        return self.pipeline is not None

    @property
    def recording(self):
        return self.rec is not None

    def start(self, device, output=None):
        self.stop()
        desc = (f"alsasrc name=src device={device} ! {self.CAPS} ! "
                "tee name=t "
                "t. ! queue max-size-time=300000000 leaky=downstream ! "
                # sync=false: play the samples as they arrive. Aligning each
                # 10 ms of live audio to the clock leaves it no slack, and an
                # output that works in large chunks (the speaker takes 130 ms
                # at a time) then drops a quarter of the audio as "late".
                "audioconvert ! pulsesink name=out sync=false "
                "t. ! queue max-size-time=2000000000 leaky=downstream ! "
                "appsink name=tap emit-signals=true sync=false async=false "
                "max-buffers=200 drop=true")
        try:
            self.pipeline = Gst.parse_launch(desc)
        except GLib.Error as e:
            self.pipeline = None
            self.on_error(e.message)
            return False
        self.sink = self.pipeline.get_by_name("out")
        self.sink.set_property("client-name", "FM Radio")
        props = Gst.Structure.new_empty("props")
        props.set_value("media.role", "music")
        props.set_value("media.name", "FM Radio")
        self.sink.set_property("stream-properties", props)
        if output:
            self.sink.set_property("device", output)
        # The stream plays at full level; loudness is the output's own
        # volume, which is what the system and the slider show.
        self.sink.set_property("volume", 1.0)
        self.pipeline.get_by_name("tap").connect("new-sample", self._on_sample)
        # Both ends offer a clock, and which one the pipeline picked varied
        # from start to start; the output's clock also jumps when the stream
        # moves to another output. Use the system clock, always.
        self.pipeline.use_clock(Gst.SystemClock.obtain())
        bus = self.pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self._on_bus_error)
        self.pipeline.set_state(Gst.State.PLAYING)
        return True

    def _on_bus_error(self, _bus, msg):
        err, _dbg = msg.parse_error()
        text = err.message
        self.stop()
        self.on_error(text)

    def _on_sample(self, tap):
        """Streaming thread: hand each captured buffer to the recorder."""
        sample = tap.emit("pull-sample")
        if sample is None:
            return Gst.FlowReturn.OK
        with self.lock:
            rec = self.rec
            if rec is None:
                return Gst.FlowReturn.OK
            data = sample.get_buffer()
            frames = data.get_size() // 4
            # A new buffer over the same memory: the original also goes to
            # the playback branch and must keep its own timestamps.
            buf = data.copy_region(Gst.BufferCopyFlags.MEMORY, 0,
                                   data.get_size())
            buf.pts = self.rec_frames * Gst.SECOND // self.RATE
            buf.dts = Gst.CLOCK_TIME_NONE
            buf.duration = frames * Gst.SECOND // self.RATE
            self.rec_frames += frames
            rec[1].emit("push-buffer", buf)
        return Gst.FlowReturn.OK

    def stop(self):
        """Stop everything; a recording in progress is finished first."""
        self._finish_recording(wait=True)
        if not self.pipeline:
            return
        self.pipeline.get_bus().remove_signal_watch()
        self.pipeline.set_state(Gst.State.NULL)
        self.pipeline = self.sink = None

    def set_output(self, output):
        """Switch the output; a recording is not affected."""
        if not self.pipeline or not output:
            return
        self.sink.set_property("device", output)
        _move_own_stream(output)
        self.sink.set_property("volume", 1.0)

    def start_recording(self, path, fmt, quality, done=None):
        """Record to path; done(path, error) is called when the file is
        complete, whether it was stopped or failed."""
        if not self.pipeline or self.rec:
            return False
        desc = (f"appsrc name=in format=time caps=\"{self.CAPS}\" "
                "block=false max-bytes=4000000 ! audioconvert ! "
                + fmt[4].format(q=quality) + " ! filesink name=file")
        try:
            pipeline = Gst.parse_launch(desc)
        except GLib.Error as e:
            self.on_error(e.message)
            return False
        os.makedirs(os.path.dirname(path), exist_ok=True)
        pipeline.get_by_name("file").set_property("location", path)
        bus = pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message::eos", self._on_rec_message)
        bus.connect("message::error", self._on_rec_message)
        pipeline.set_state(Gst.State.PLAYING)
        with self.lock:
            self.rec_frames = 0
            self.rec = (pipeline, pipeline.get_by_name("in"), path, done)
        self.rec_started = time.monotonic()
        return True

    def stop_recording(self):
        """Ask the recording to finish; its done callback follows."""
        with self.lock:
            rec = self.rec
        if rec:
            rec[1].emit("end-of-stream")

    def _on_rec_message(self, _bus, msg):
        error = None
        if msg.type == Gst.MessageType.ERROR:
            error = msg.parse_error()[0].message
        self._finish_recording(error=error)

    def _finish_recording(self, wait=False, error=None):
        with self.lock:
            rec, self.rec = self.rec, None
        if not rec:
            return
        pipeline, src, path, done = rec
        if wait:
            # Closing down: end the stream and give the file time to close.
            src.emit("end-of-stream")
            msg = pipeline.get_bus().timed_pop_filtered(
                5 * Gst.SECOND, Gst.MessageType.EOS | Gst.MessageType.ERROR)
            if msg is not None and msg.type == Gst.MessageType.ERROR:
                error = msg.parse_error()[0].message
        pipeline.get_bus().remove_signal_watch()
        pipeline.set_state(Gst.State.NULL)
        if done:
            done(path, error)


