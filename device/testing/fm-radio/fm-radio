    # device -----------------------------------------------------------

    def open_radio(self):
        try:
            self.radio = Radio(DEVICE)
        except OSError as e:
            self.radio = None
            if e.errno == errno.ENOENT:
                msg = ("No FM receiver found. On the LG V30 the receiver "
                       "shares the Bluetooth chip: turn Bluetooth on.")
            elif e.errno in (errno.EACCES, errno.EPERM):
                msg = f"No permission to open {DEVICE}."
            else:
                msg = f"Cannot open {DEVICE}: {e.strerror}"
            self.banner.set_title(msg)
            self.banner.set_revealed(True)
            self.freq_label.set_label("—")
            return False
        self.banner.set_revealed(False)
        for cid, val in ((V4L2_CID_RDS_RECEPTION, 1), (V4L2_CID_AUDIO_MUTE, 0)):
            try:
                self.radio.set_ctrl(cid, val)
            except OSError:
                pass
        self.update_frequency()
        if not self.capture:
            self.audio_row.set_subtitle(
                "Not available: this kernel has no FM capture device, so "
                "the station plays nowhere. Tuning and RDS work.")
        elif not self.audio:
            self.audio_row.set_subtitle(
                "Not available: GStreamer is not installed.")
        else:
            for g in self.sound_groups:
                g.set_sensitive(True)
            # The receiver powers up on the first tuner call, and its audio
            # port only answers once it is on: retune before starting sound.
            self.tune(self.radio.frequency_khz(), then=self.start_audio)
            return True
        for g in self.sound_groups:
            g.set_sensitive(False)
        return True

    # sound ---------------------------------------------------------------

    def start_audio(self):
        if not (self.audio and self.capture and self.radio):
            return
        if not self.play_row.get_active():
            self.audio_row.set_subtitle("Off")
            return
        if self.audio.start(self.capture, self.selected_output()):
            self.audio_row.set_subtitle(f"Playing from {self.capture}")
            GLib.timeout_add_seconds(5, self.audio_settled)

    def audio_settled(self):
        if self.audio.playing:
            self.audio_retries = 0
        return GLib.SOURCE_REMOVE

    def on_audio_error(self, text):
        # The receiver's audio port can take a moment to answer after the
        # tuner powers up; the first start may be refused. Try a few times.
        if self.audio_retries < 9 and self.play_row.get_active():
            self.audio_retries += 1
            self.audio_row.set_subtitle("Starting…")
            if self.audio_retries % 3 == 0:
                # Still nothing: the receiver only joins the audio bus at
                # the moment it is switched on, and sometimes misses it.
                # Switch it off and on again, then retry.
                GLib.timeout_add(300, self.restart_tuner)
            else:
                GLib.timeout_add(2500, self.retry_audio)
            return
        self.audio_retries = 0
        self.audio_row.set_subtitle(f"Stopped: {text}")
        self.set_recording_ui(False)
        self.record_button.set_sensitive(True)
        if self.play_row.get_active():
            # Reflect the stop, but keep "play" as the saved preference.
            self.keep_play_setting = True
            self.play_row.set_active(False)
            self.keep_play_setting = False

    def restart_tuner(self):
        if self.radio and not self.busy:
            self.radio.close()
            self.radio = None
            GLib.timeout_add(800, self.reopen_tuner)
        else:
            GLib.timeout_add(2500, self.retry_audio)
        return GLib.SOURCE_REMOVE

    def reopen_tuner(self):
        self.open_radio()           # retunes, then starts the sound again
        return GLib.SOURCE_REMOVE

    def retry_audio(self):
        if self.play_row.get_active() and not self.audio.playing:
            self.start_audio()
        return GLib.SOURCE_REMOVE

    def on_play_toggled(self, *_):
        on = self.play_row.get_active()
        if not self.keep_play_setting:
            self.settings["play"] = on
            save_settings(self.settings)
        if not self.audio:
            return
        if on:
            self.start_audio()
        else:
            self.audio.stop()       # finishes a recording in progress
            self.audio_row.set_subtitle("Off")

    def selected_output(self):
        i = self.output_row.get_selected()
        if 0 < i <= len(self.outputs):
            return self.outputs[i - 1][0]
        return None

    def volume_output(self):
        """The output whose volume the slider shows and sets."""
        return self.selected_output() or self.default_output

    def show_volume(self):
        vol, muted = self.output_state.get(self.volume_output(), (None, False))
        self.volume_row.set_subtitle("Muted" if muted else "")
        self.volume.set_sensitive(vol is not None)
        # Leave the slider alone while a finger is on it.
        if vol is None or time.monotonic() - self.volume_touched < 0.8:
            return
        self.volume.handler_block(self.volume_handler)
        self.volume.set_value(min(vol, 100))
        self.volume.handler_unblock(self.volume_handler)

    def refresh_outputs(self):
        outputs, self.output_state, self.default_output = query_outputs()
        if outputs == self.outputs and self.output_model.get_n_items():
            self.show_volume()
            return GLib.SOURCE_CONTINUE
        want = self.selected_output() if self.outputs else \
            self.settings.get("output")
        self.outputs = outputs
        self.output_row.handler_block(self.output_handler)
        self.output_model.splice(
            0, self.output_model.get_n_items(),
            ["System default"] + [desc for _name, desc in outputs])
        names = [name for name, _desc in outputs]
        self.output_row.set_selected(
            names.index(want) + 1 if want in names else 0)
        self.output_row.handler_unblock(self.output_handler)
        self.show_volume()
        return GLib.SOURCE_CONTINUE

    def on_output_selected(self, *_):
        name = self.selected_output()
        self.settings["output"] = name
        save_settings(self.settings)
        self.volume_touched = 0.0
        self.show_volume()
        if not (self.audio and self.audio.playing):
            return
        if name:
            self.audio.set_output(name)
        elif not self.audio.recording:
            self.start_audio()      # back to whatever the system default is

    def on_volume_changed(self, _scale):
        """The slider is the volume of the chosen output itself, the same
        value the system shows; set it there, a few times a second at most."""
        self.volume_touched = time.monotonic()
        if not self.volume_apply_pending:
            self.volume_apply_pending = True
            GLib.timeout_add(80, self.apply_volume)

    def apply_volume(self):
        self.volume_apply_pending = False
        sink = self.volume_output()
        if sink:
            set_output_volume(sink, round(self.volume.get_value()))
        return GLib.SOURCE_REMOVE

    def current_format(self):
        i = self.format_row.get_selected()
        return self.formats[i] if 0 <= i < len(self.formats) else None

    def fill_qualities(self):
        fmt = self.current_format()
        if not fmt:
            return
        self.quality_model.splice(0, self.quality_model.get_n_items(),
                                  [label for label, _v in fmt[3]])
        saved = self.settings.get("quality", {}).get(fmt[0])
        if not isinstance(saved, int) or not 0 <= saved < len(fmt[3]):
            saved = DEFAULT_QUALITY.get(fmt[0], 0)
        self.quality_row.set_selected(saved)
        self.quality_row.set_sensitive(len(fmt[3]) > 1)

    def on_format_selected(self, *_):
        fmt = self.current_format()
        if fmt:
            self.settings["format"] = fmt[0]
            save_settings(self.settings)
            self.fill_qualities()

    def on_quality_selected(self, *_):
        fmt = self.current_format()
        i = self.quality_row.get_selected()
        if fmt and 0 <= i < len(fmt[3]):
            self.settings.setdefault("quality", {})[fmt[0]] = i
            save_settings(self.settings)

    def on_rds_setting(self, row, _pspec):
        self.settings["rds"] = row.get_active()
        save_settings(self.settings)

    def close_rds_log(self):
        if self.rds_log:
            self.rds_log.close()
            self.rds_log = None

    def set_recording_ui(self, on):
        self.record_button.set_label("Stop" if on else "Start")
        if on:
            self.record_button.remove_css_class("suggested-action")
            self.record_button.add_css_class("destructive-action")
        else:
            self.record_button.remove_css_class("destructive-action")
            self.record_button.add_css_class("suggested-action")
            self.record_row.set_subtitle(f"Saved in {recordings_dir()}")
        if not on:
            self.close_rds_log()
        self.format_row.set_sensitive(not on)
        self.rds_row.set_sensitive(not on)
        self.quality_row.set_sensitive(
            not on and len((self.current_format() or (0, 0, 0, []))[3]) > 1)

    def on_record_clicked(self, *_):
        if not self.audio:
            return
        if self.audio.recording:
            self.record_button.set_sensitive(False)
            self.audio.stop_recording()
            return
        fmt = self.current_format()
        if not fmt:
            return
        if not self.audio.playing:
            self.toast("Turn Play on to record")
            return
        khz = self.radio.frequency_khz() if self.radio else 0
        name = "".join(c for c in self.rds.name if c.isalnum() or c in " -_")
        stamp = time.strftime("%Y-%m-%d %H-%M-%S")
        title = f"FM {khz / 1000:.1f} MHz {name.strip()}".strip()
        path = os.path.join(recordings_dir(), f"{title} {stamp}.{fmt[2]}")
        quality = fmt[3][min(self.quality_row.get_selected(),
                             len(fmt[3]) - 1)][1]
        if self.audio.start_recording(path, fmt, quality,
                                      self.on_recording_saved):
            self.set_recording_ui(True)
            if self.rds_row.get_active():
                try:
                    self.rds_log = RdsLog(os.path.splitext(path)[0],
                                          True, True, khz)
                except OSError as e:
                    self.toast(f"RDS log not written: {e.strerror}")

    def on_recording_saved(self, path, error):
        self.record_button.set_sensitive(True)
        self.set_recording_ui(False)
        if error:
            self.toast(f"Recording failed: {error}")
        else:
            self.toast(f"Saved {os.path.basename(path)}")

    def run_blocking(self, fn, done):
        """Run a blocking tuner call off the UI thread."""
        if self.busy or not self.radio:
            return
        self.busy = True

        def worker():
            err = None
            try:
                fn()
            except OSError as e:
                err = e
            GLib.idle_add(finish, err)

        def finish(err):
            self.busy = False
            if err:
                self.toast(f"Tuner error: {err.strerror}")
            done()
            return False

        threading.Thread(target=worker, daemon=True).start()

    # actions ------------------------------------------------------------

    def step(self, delta_khz):
        if not self.radio:
            return
        khz = self.radio.frequency_khz() + delta_khz
        if khz > self.radio.high_khz:
            khz = self.radio.low_khz
        elif khz < self.radio.low_khz:
            khz = self.radio.high_khz
        self.tune(khz)

    def tune(self, khz, then=None):
        def done():
            self.update_frequency()
            if then:
                then()
        self.run_blocking(lambda: self.radio.tune_khz(khz), done)

    def seek(self, upward):
        self.freq_label.set_label("Seeking…")
        self.run_blocking(lambda: self.radio.seek(upward), self.update_frequency)

    def on_add_preset(self, *_):
        if not self.radio:
            return
        self.presets.append(self.radio.frequency_khz())
        save_presets(self.presets)
        self.presets = load_presets()
        self.refresh_presets()

    def refresh_presets(self):
        for row in self.preset_rows:
            self.preset_group.remove(row)
        self.preset_rows = []
        for khz in self.presets:
            row = Adw.ActionRow(title=f"{khz / 1000:.1f} MHz", activatable=True)
            row.connect("activated", lambda _r, k=khz: self.tune(k))
            rm = Gtk.Button(icon_name="user-trash-symbolic",
                            valign=Gtk.Align.CENTER)
            rm.add_css_class("flat")
            rm.connect("clicked", lambda _b, k=khz: self.remove_preset(k))
            row.add_suffix(rm)
            self.preset_group.add(row)
            self.preset_rows.append(row)

    def remove_preset(self, khz):
        self.presets = [p for p in self.presets if p != khz]
        save_presets(self.presets)
        self.refresh_presets()

    # status ---------------------------------------------------------------

    def update_frequency(self):
        if not self.radio:
            return
        try:
            khz = self.radio.frequency_khz()
        except OSError:
            return
        self.freq_label.set_label(f"{khz / 1000:.1f} MHz")
        self.rds.reset()
        if self.rds_log:
            self.rds_log.tuned(khz)
        self.name_label.set_label("")
        self.text_label.set_label("")

    def poll(self):
        if not self.radio:
            return GLib.SOURCE_CONTINUE
        if self.busy:
            return GLib.SOURCE_CONTINUE
        try:
            t = self.radio.tuner()
        except OSError:
            return GLib.SOURCE_CONTINUE
        # V4L2 signal is 0..65535
        self.signal_bar.set_value(max(0, t.signal) * 100 / 65535)
        self.stereo_row.set_subtitle(
            "Yes" if t.rxsubchans & V4L2_TUNER_SUB_STEREO else "Mono")
        changed = False
        raw, blocks = self.radio.read_rds()
        for blk, word in blocks:
            changed |= self.rds.feed(blk, word)
        if self.rds_log:
            self.rds_log.blocks(raw)
            self.rds_log.update(self.rds, max(0, t.signal) * 100 / 65535,
                                bool(t.rxsubchans & V4L2_TUNER_SUB_STEREO))
        if changed:
            self.name_label.set_label(self.rds.name)
            self.text_label.set_label(self.rds.text)
        if self.audio and self.audio.recording:
            secs = int(time.monotonic() - self.audio.rec_started)
            self.record_row.set_subtitle(
                f"Recording {secs // 60}:{secs % 60:02d}")
        return GLib.SOURCE_CONTINUE

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text))

    def on_close(self, *_):
        self.sound_watch.stop()
        if self.audio:
            self.audio.stop()       # also finishes a recording in progress
        self.close_rds_log()
        if self.radio:
            try:
                self.radio.set_ctrl(V4L2_CID_AUDIO_MUTE, 1)
            except OSError:
                pass
            self.radio.close()
        return False


class RadioApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = self.props.active_window or RadioWindow(self)
        win.present()


if __name__ == "__main__":
    sys.exit(RadioApp().run(sys.argv))
