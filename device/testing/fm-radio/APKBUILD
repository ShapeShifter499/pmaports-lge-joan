pkgname=fm-radio
pkgver=0.1
pkgrel=0
pkgdesc="Tune a V4L2 FM radio receiver, with RDS and presets (GTK4/libadwaita)"
url="https://github.com/ShapeShifter499/lg-v30-joan-pmos-packages"
arch="noarch"
license="GPL-3.0-or-later"
depends="python3 py3-gobject3 gtk4.0 libadwaita"
options="!check"
source="
	fm-radio
	io.github.ShapeShifter499.FmRadio.desktop
	io.github.ShapeShifter499.FmRadio.svg
	"

package() {
	install -Dm755 "$srcdir"/fm-radio "$pkgdir"/usr/bin/fm-radio
	install -Dm644 "$srcdir"/io.github.ShapeShifter499.FmRadio.desktop \
		"$pkgdir"/usr/share/applications/io.github.ShapeShifter499.FmRadio.desktop
	install -Dm644 "$srcdir"/io.github.ShapeShifter499.FmRadio.svg \
		"$pkgdir"/usr/share/icons/hicolor/scalable/apps/io.github.ShapeShifter499.FmRadio.svg
}
