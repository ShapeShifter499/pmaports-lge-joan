# Maintainer: Lance <Gero3977@gmail.com>
pkgname=fm-radio
pkgver=0.2
pkgrel=7
pkgdesc="FM radio for V4L2 receivers: listen, record, RDS and presets (GTK4/libadwaita)"
url="https://github.com/ShapeShifter499/lg-v30-joan-pmos-packages"
arch="noarch"
license="GPL-3.0-or-later"
# Sound: GStreamer reads the ALSA capture device, plays through the sound
# server (pulsesink, also served by pipewire-pulse) and encodes recordings;
# pactl lists the outputs. gst-plugins-bad only adds AAC and is optional.
depends="
	gst-plugins-base
	gst-plugins-good
	gstreamer
	gtk4.0
	libadwaita
	pulseaudio-utils
	py3-gobject3
	python3
	"
options="!check"
source="
	fm-radio
	io.github.ShapeShifter499.FmRadio.desktop
	io.github.ShapeShifter499.FmRadio.svg
	"

package() {
	install -Dm755 "$srcdir"/fm-radio "$pkgdir"/usr/bin/fm-radio
	install -Dm644 "$srcdir"/io.github.ShapeShifter499.FmRadio.desktop \
		"$pkgdir"/usr/share/applications/io.github.ShapeShifter499.FmRadio.desktop
	install -Dm644 "$srcdir"/io.github.ShapeShifter499.FmRadio.svg \
		"$pkgdir"/usr/share/icons/hicolor/scalable/apps/io.github.ShapeShifter499.FmRadio.svg
}
