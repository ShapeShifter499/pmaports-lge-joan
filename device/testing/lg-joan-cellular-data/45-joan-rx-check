#!/bin/sh
# NetworkManager dispatcher: schedule joan-rx-check (in the background) when
# cellular data comes up, and when Wi-Fi goes away and cellular has to carry
# the traffic again.
case "$2" in
up) case "$DEVICE_IP_IFACE" in qmapmux* | rmnet*) ;; *) exit 0 ;; esac ;;
down) case "$DEVICE_IFACE" in wlan*) ;; *) exit 0 ;; esac ;;
*) exit 0 ;;
esac
systemd-run --no-block --quiet --collect --unit="joan-rx-check-$$" \
	/usr/libexec/lg-joan-cellular-data/joan-rx-check >/dev/null 2>&1
exit 0
