#!/bin/sh
# Recover the joan cellular RX stall without restarting the modem.
#
# On most cold boots (5 of 6 RAM boots of r60 on the US998 bench) the
# bearer comes up but the IPA mux receives almost nothing, for good. A
# modem restart fixes it but also leaves Wi-Fi (ath10k, whose firmware
# runs on the modem) dead until reboot. Bouncing rmnet_ipa0 with the
# connection down fixes it in seconds and leaves Wi-Fi alone.
#
# 30 s after cellular comes up (or Wi-Fi goes away), ask the mux link's own
# DNS servers for ipv4only.arpa, which always has A records. Bounce only if
# three tries fail, and only when it matters and is safe:
#  - not while Wi-Fi is connected (traffic goes there; the Wi-Fi "down"
#    event re-runs this check when cellular has to take over),
#  - not during a call (rmnet_ipa0 carries every PDN, IMS included),
#  - at most once per 10 minutes.
set -u
stamp=/run/joan-rx-check.last
sleep 30

active=$(nmcli -t -f TYPE,STATE connection show --active 2>/dev/null)
echo "$active" | grep -q '^gsm:activated$' || exit 0
echo "$active" | grep -q '^802-11-wireless:activated$' && exit 0

iface=$(ip -o addr show scope global 2>/dev/null |
	awk '$2 ~ /^(qmapmux|rmnet_data)/ { print $2; exit }')
[ -n "$iface" ] || exit 0

for _ in 1 2 3; do
	timeout 5 resolvectl query --cache=no --legend=no -i "$iface" \
		-t A ipv4only.arpa >/dev/null 2>&1 && exit 0
	sleep 5
done

if mmcli -m any --voice-list-calls 2>/dev/null | grep -qiE '\((active|held|waiting|dialing|ringing-out|ringing-in)\)'; then
	logger -t joan-rx-check "$iface: no data, but a call is up; not bouncing"
	exit 0
fi
now=$(date +%s)
if [ -f "$stamp" ] && [ $((now - $(cat "$stamp"))) -lt 600 ]; then
	logger -t joan-rx-check "$iface: no data, but bounced <10 min ago; leaving it"
	exit 0
fi
echo "$now" >"$stamp"

con=$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null |
	awk -F: '$2 == "gsm" { print $1; exit }')
[ -n "$con" ] || exit 0
logger -t joan-rx-check "$iface: no data on '$con'; bouncing rmnet_ipa0"
nmcli connection down "$con" >/dev/null 2>&1
sleep 2
ip link set rmnet_ipa0 down
sleep 2
ip link set rmnet_ipa0 up
sleep 2
nmcli connection up "$con" >/dev/null 2>&1
exit 0
