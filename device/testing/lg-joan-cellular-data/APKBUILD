# Maintainer: Lance <Gero3977@gmail.com>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=lg-joan-cellular-data
pkgver=0.2
pkgrel=9
pkgdesc="LG V30 (joan) cellular data defaults — rmnet DAD workaround, NetworkManager profile, IPv4 on IPv6-only SIMs (464XLAT)"
url="https://github.com/ShapeShifter499/lg-v30-joan-pmos-packages"
arch="noarch"
license="MIT"
# clatd: CLAT client by Tore Anderson (MIT), https://github.com/toreanderson/clatd
depends="
	clatd
	iproute2
	mobile-broadband-provider-info
	modemmanager
	networkmanager
	nftables
	"
subpackages="$pkgname-systemd:systemd_unit"
options="!check"
source="
	40-joan-rmnet-nodad
	45-joan-rx-check
	70-joan-rmnet-nodad.rules
	lg-joan-cellular-data.nmconnection
	clatd.conf
	clatd.service
	joan-clat-down
	joan-clat-reset
	joan-clat-up
	joan-clat-retry
	joan-clat-run
	joan-rx-check
	joan-clat-retry.service
	joan-clat-retry.timer
	85-lg-joan-cellular-data.preset
	"

package() {
	install -Dm755 "$srcdir/40-joan-rmnet-nodad" \
		"$pkgdir/usr/lib/NetworkManager/dispatcher.d/40-joan-rmnet-nodad"
	install -Dm755 "$srcdir/45-joan-rx-check" \
		"$pkgdir/usr/lib/NetworkManager/dispatcher.d/45-joan-rx-check"
	install -Dm644 "$srcdir/70-joan-rmnet-nodad.rules" \
		"$pkgdir/etc/udev/rules.d/70-joan-rmnet-nodad.rules"
	install -Dm600 "$srcdir/lg-joan-cellular-data.nmconnection" \
		"$pkgdir/usr/lib/NetworkManager/system-connections/lg-joan-cellular-data.nmconnection"
	install -Dm644 "$srcdir/clatd.conf" "$pkgdir/etc/clatd.conf"
	install -Dm755 -t "$pkgdir/usr/libexec/$pkgname" \
		"$srcdir/joan-clat-down" \
		"$srcdir/joan-clat-reset" \
		"$srcdir/joan-clat-up" \
		"$srcdir/joan-clat-retry" \
		"$srcdir/joan-clat-run" \
		"$srcdir/joan-rx-check"
}

systemd_unit() {
	pkgdesc="systemd units for clatd (started by the NetworkManager dispatcher) and its retry timer"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 -t "$subpkgdir/usr/lib/systemd/system" \
		"$srcdir/clatd.service" \
		"$srcdir/joan-clat-retry.service" \
		"$srcdir/joan-clat-retry.timer"
	install -Dm644 "$srcdir/85-lg-joan-cellular-data.preset" \
		"$subpkgdir/usr/lib/systemd/system-preset/85-lg-joan-cellular-data.preset"
}
