	lg-joan-cellular-data.nmconnection
	"

package() {
	install -Dm644 "$srcdir/70-joan-rmnet-nodad.rules" \
		"$pkgdir/etc/udev/rules.d/70-joan-rmnet-nodad.rules"
	install -Dm600 "$srcdir/lg-joan-cellular-data.nmconnection" \
		"$pkgdir/usr/lib/NetworkManager/system-connections/lg-joan-cellular-data.nmconnection"
}
