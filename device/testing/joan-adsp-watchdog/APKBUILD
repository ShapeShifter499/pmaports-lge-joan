# Reference: <https://postmarketos.org/devicepkg>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=joan-adsp-watchdog
pkgver=0.1
pkgrel=0
pkgdesc="LG V30 (joan): recover the sound card when the ADSP boots without QRTR services"
url="https://github.com/ShapeShifter499/linux-lg-v30-joan"
arch="noarch"
license="MIT"
depends="qrtr"
options="!check"
source="
	85-joan-adsp-watchdog.preset
	joan-adsp-boot-probe
	joan-adsp-boot-probe.service
	joan-adsp-watchdog
	joan-adsp-watchdog-recheck.timer
	joan-adsp-watchdog.service
	README.md
	"

package() {
	install -Dm755 "$srcdir"/joan-adsp-watchdog \
		"$pkgdir"/usr/libexec/joan-adsp-watchdog
	install -Dm755 "$srcdir"/joan-adsp-boot-probe \
		"$pkgdir"/usr/libexec/joan-adsp-boot-probe
	install -Dm644 -t "$pkgdir"/usr/lib/systemd/system \
		"$srcdir"/joan-adsp-watchdog.service \
		"$srcdir"/joan-adsp-watchdog-recheck.timer \
		"$srcdir"/joan-adsp-boot-probe.service
	install -Dm644 "$srcdir"/85-joan-adsp-watchdog.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/85-joan-adsp-watchdog.preset
	install -Dm644 "$srcdir"/README.md \
		"$pkgdir"/usr/share/doc/joan-adsp-watchdog/README.md
}

