From 2452f5722221b06feda74e6c3f272190d00f6257 Mon Sep 17 00:00:00 2001
From: Lance <Gero3977@gmail.com>
Date: Sun, 26 Jul 2026 01:37:45 -0700
Subject: [PATCH 1/6] arm64: dts: qcom: msm8998-lge-joan: enable the Adreno 540

Enable the GPU on joan. Three changes are needed together, each established by
measurement rather than by guessing:

msm8998.dtsi points power-domains at the RPM VDDMX voltage domain. The binding
allows a single power-domain, and every other Adreno 5xx in tree attaches the
GX GDSC instead (msm8996: power-domains = <&mmcc GPU_GX_GDSC>). With the RPM
domain in that slot the GPUCC gpu_gx / gpu_cx GDSCs have no consumer and never
power up, so the first register write lands on an unpowered block and hangs the
AHB bus. gpu_gx is a child of gpu_cx, so enabling GX brings CX up with it.

The zap shader needs its firmware-name spelled with the .mdt extension, and
gpu_mem needs a reg that actually covers where the loader places it.

The OPP table is capped at 257 MHz for bring-up, because msm_gpu's enable_clk()
sets the core clock to gpu->fast_rate -- the highest OPP -- on every resume,
before any register access, and there is no voltage story for the higher
corners yet.

Two known gaps are recorded rather than papered over. Repointing power-domains
at the GDSC orphans the opp-level performance-state votes upstream attaches to
RPMPD_VDDMX, because a GDSC genpd has no performance states and the msm driver
has no multi-power-domain support. And the OPP carries no opp-microvolt, so
a540_lm_setup() configures the GPMU's AGC with 0 mV.

Signed-off-by: Lance <Gero3977@gmail.com>
Assisted-by: Claude-Code:claude-opus-5
---
 arch/arm64/boot/dts/qcom/msm8998-lge-joan.dts | 73 ++++++++++++++++++-
 1 file changed, 71 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998-lge-joan.dts b/arch/arm64/boot/dts/qcom/msm8998-lge-joan.dts
index d726ced59..0027dbfe3 100644
--- a/arch/arm64/boot/dts/qcom/msm8998-lge-joan.dts
+++ b/arch/arm64/boot/dts/qcom/msm8998-lge-joan.dts
@@ -92,12 +92,19 @@ reserved@85f00000 {
 		};
 
 		reserved@95215000 {
-			reg = <0x0 0x95215000 0x0 0x3eb000>;
+			/*
+			 * Extended to 0x95700000 so it also covers mainline's
+			 * default gpu_mem spot (0x95600000), which lies inside
+			 * LG's SLPI range; gpu_mem moves to LG's pil_ipa_gpu
+			 * address below.
+			 */
+			reg = <0x0 0x95215000 0x0 0x4eb000>;
 			no-map;
 		};
 
 		reserved@95800000 {
-			reg = <0x0 0x95800000 0x0 0x500000>;
+			/* Ends at 0x95c00000: LG's pil_ipa_gpu starts there. */
+			reg = <0x0 0x95800000 0x0 0x400000>;
 			no-map;
 		};
 
@@ -631,3 +638,65 @@ touchscreen@49 {
 		pinctrl-0 = <&touch_int_default &touch_reset_default>;
 	};
 };
+
+/*
+ * GPU (Adreno 540).
+ *
+ * gpu_mem moves to 0x95c00000, matching LG's pil_ipa_gpu region. This is
+ * required because mainline's default 0x95600000 lies inside LG's SLPI
+ * carve-out (0x94d00000-0x95c00000): letting the allocator hand out
+ * firmware-owned pages there causes an immediate silent XPU reset. The
+ * a540 zap blob itself is RELOCATABLE (QCOM_MDT_RELOCATABLE), so it does
+ * not require any particular address -- an earlier comment claiming it was
+ * address-locked was wrong; the move is about LG's memory map, not the blob.
+ *
+ * Firmware (a540_zap.*, a540_gpmu.fw2, a530_pm4/pfp) is not redistributable
+ * and must be present in /lib/firmware/qcom on the rootfs.
+ */
+&gpu_mem {
+	reg = <0x0 0x95c00000 0x0 0x100000>;
+};
+
+&adreno_gpu {
+	status = "okay";
+
+	/*
+	 * msm8998.dtsi points power-domains at the RPM VDDMX voltage domain,
+	 * which drives opp-level but does NOT switch the GPU on. The binding
+	 * allows a single power-domain, and every other Adreno 5xx in tree
+	 * (e.g. msm8996: power-domains = <&mmcc GPU_GX_GDSC>) attaches the GX
+	 * GDSC instead. With the RPM domain in that slot the GPUCC gpu_gx /
+	 * gpu_cx GDSCs have no consumer, never power up, and the clocks that
+	 * depend on them never produce a rate -- so the first register write
+	 * lands on an unpowered, unclocked block and hangs the AHB bus.
+	 * gpu_gx is a child of gpu_cx, so enabling GX brings CX up with it.
+	 */
+	power-domains = <&gpucc GPU_GX_GDSC>;
+
+	vdd-supply = <&pm8005_s1>;
+
+	zap-shader {
+		memory-region = <&gpu_mem>;
+		firmware-name = "qcom/a540_zap.mdt";
+	};
+};
+
+/*
+ * GPU OPP cap for bring-up.
+ *
+ * msm_gpu's enable_clk() sets the core clock to gpu->fast_rate -- the HIGHEST
+ * OPP -- as part of every resume, before any register access. Mainline's
+ * msm8998 table tops out at 710000097 Hz (TURBO), which is above the 650 MHz
+ * maximum downstream uses (msm8998-gpu.dtsi pwrlevel@0), and VDD_GFX here sits
+ * at ~752 mV with no CPR to raise it. Requesting turbo on a low-SVS voltage is
+ * not survivable, so drop everything above MIN_SVS until the rail is properly
+ * scaled.
+ */
+&gpu_opp_table {
+	/delete-node/ opp-710000097;
+	/delete-node/ opp-670000048;
+	/delete-node/ opp-596000097;
+	/delete-node/ opp-515000097;
+	/delete-node/ opp-414000000;
+	/delete-node/ opp-342000000;
+};
