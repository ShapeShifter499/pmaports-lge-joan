# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/defconfig (with USB gadget,
# pstore, display/backlight and Qualcomm GPU/UFS/SDHCI/QMP-PHY drivers
# forced built-in)
maintainer="Lance <Gero3977@gmail.com>"
_flavor="lge-joan"
pkgname=linux-$_flavor
pkgver=7.2.0_rc2
pkgrel=2
_commit="323451cb679aeba2c51dce2fb15a11410cb13631"
pkgdesc="Mainline kernel for the LG V30 (joan)"
arch="aarch64"
_carch="arm64"
_config="config-$_flavor.$arch"
url="https://github.com/ShapeShifter499/linux-lg-v30-joan"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
"
makedepends="
	bash
	bc
	bison
	elfutils-dev
	findutils
	flex
	linux-headers
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	xz
	zlib-dev
"

source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	$_config
	0001-arm64-dts-qcom-msm8998-lge-joan-enable-the-Adreno-54.patch
	0002-arm64-dts-qcom-msm8998-add-the-GPU-BIMC_GFX-source-c.patch
	0003-drm-msm-fix-NULL-deref-when-SUBMIT-is-a-context-s-fi.patch
	0004-drm-msm-adreno-keep-A540-active-across-runtime-PM.patch
	0005-drm-msm-dsi-exclude-DCS-transfers-from-frame-kickoff.patch
	0006-drm-panel-lg-sw43402-add-runtime-backlight-control.patch
	0007-dt-bindings-display-msm-describe-A540-mem_src-clock.patch
	0008-dt-bindings-display-msm-describe-GPU-supplies.patch
	0009-drm-panel-lg-sw43402-restore-full-byte-brightness-ra.patch
	0010-docs-clarify-A540-firmware-distribution-split.patch
"
builddir="$srcdir/linux-lg-v30-joan-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor"
}

package() {
	mkdir -p "$pkgdir/boot"

	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir/boot" \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

