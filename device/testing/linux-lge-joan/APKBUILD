# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/defconfig (with USB gadget,
# pstore, display/backlight and Qualcomm GPU/UFS/SDHCI/QMP-PHY drivers
# forced built-in)
maintainer="Lance <Gero3977@gmail.com>"
_flavor="lge-joan"
_dtb="qcom/msm8998-lge-joan"   # must match deviceinfo_dtb
pkgname=linux-$_flavor
pkgver=7.2.0_rc2
pkgrel=25
_commit=5710765836f4b70c4a6ce2ac5ced78500c2e08ff
pkgdesc="Mainline kernel for the LG V30 (joan)"
arch="aarch64"
_carch="arm64"
_config="config-$_flavor.$arch"
url="https://github.com/ShapeShifter499/linux-lg-v30-joan"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
"
makedepends="
	bash
	bc
	bison
	elfutils-dev
	findutils
	flex
	linux-headers
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	xz
	zlib-dev
"

source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	$_config
"
builddir="$srcdir/linux-lg-v30-joan-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor"
}

package() {
	mkdir -p "$pkgdir/boot"

	make zinstall modules_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir/boot" \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1

	# Only joan's DTB, not dtbs_install's whole arm64 set.  The boot
	# partition is 226 MiB and dtbs_install writes 1841 files into it,
	# which leaves too little headroom to stage an upgrade's new copies
	# alongside the old ones: apk then fails mid-transaction with
	# "No space left on device" and the package is left unchanged.
	install -Dm644 "$builddir/arch/$_carch/boot/dts/${_dtb}.dtb" \
		"$pkgdir/boot/dtbs/${_dtb}.dtb"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

sha512sums="
7cca68236cb1c6faf7e0fd4143b96d1223dc7196cbf05ffbe6895f151de01df121d8451f454dc214437dc621dc253948868443854a733b83f240d2a8e69a7f36  linux-lge-joan-5710765836f4b70c4a6ce2ac5ced78500c2e08ff.tar.gz
e6d62882bda9cc1a087351037883fc474922e03487de22c66c0ff6a4d4b7e61a3383abde0745f0d2dcd36f787a15e12eb7618ba09d5baa1f480f86cf794416d6  config-lge-joan.aarch64
"
