# Reference: <https://postmarketos.org/devicepkg>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=device-lge-joan
pkgdesc="LG V30 (H930, US998, H932PR and other non-H932)"
pkgver=1
pkgrel=8
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-lge-joan
	firmware-lge-joan
	firmware-lge-joan-h930
	firmware-lge-joan-initramfs
	firmware-qcom-adreno-a530
	lge-joan-volte
	linux-lge-joan
	mkbootimg
	postmarketos-base
	soc-qcom
"
makedepends="devicepkg-dev"
source="deviceinfo
	phosh-start-timeout.conf
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Raise Phosh's start timeout; the file's header records the measurement.
	install -Dm644 "$srcdir"/phosh-start-timeout.conf \
		"$pkgdir"/usr/lib/systemd/user/mobi.phosh.Shell.service.d/10-phosh-start-timeout.conf
}

