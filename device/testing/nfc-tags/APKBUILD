arch="noarch"
license="GPL-3.0-or-later"
depends="python3 py3-gobject3 gtk4.0 libadwaita neard"
options="!check"
source="
	nfc-tags
	io.github.ShapeShifter499.NfcTags.desktop
	io.github.ShapeShifter499.NfcTags.svg
	"

package() {
	install -Dm755 "$srcdir"/nfc-tags "$pkgdir"/usr/bin/nfc-tags
	install -Dm644 "$srcdir"/io.github.ShapeShifter499.NfcTags.desktop \
		"$pkgdir"/usr/share/applications/io.github.ShapeShifter499.NfcTags.desktop
	install -Dm644 "$srcdir"/io.github.ShapeShifter499.NfcTags.svg \
		"$pkgdir"/usr/share/icons/hicolor/scalable/apps/io.github.ShapeShifter499.NfcTags.svg
}
