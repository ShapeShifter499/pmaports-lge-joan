# Maintainer: Lance <Gero3977@gmail.com>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=joan-imsd
pkgver=0.1
pkgrel=2
pkgdesc="3GPP IMS SIP UA for LG V30 (joan) VoLTE — AP-side, no vendor blobs"
url="https://github.com/ShapeShifter499/lg-v30-joan-pmos-packages"
arch="noarch"
license="MIT"
depends="python3 qmi-utils modemmanager 81voltd"
subpackages="$pkgname-openrc $pkgname-systemd:systemd_unit"
options="!check"
source="
	joan-ims
	joan-imsd.initd
	joan-imsd.service
	joan-ims.desktop
	joan_ims_live.py
	joan_ims_profiles.py
	joan_ims_esp.py
	joan_ims_ipsec.py
	joan_ims_pco.py
	joan_ims_register.py
	joan_ims_ua.py
	carrier-profiles.json
	profiles/cmcc-cn.yaml
	tmo-us.yaml
	"

package() {
	install -Dm755 "$srcdir/joan-ims" "$pkgdir/usr/bin/joan-ims"
	install -Dm644 "$srcdir/joan-ims.desktop" \
		"$pkgdir/usr/share/applications/joan-ims.desktop"
	install -d "$pkgdir/usr/lib/joan-imsd" \
		"$pkgdir/usr/share/joan-imsd/profiles" \
		"$pkgdir/etc/joan-imsd" \
		"$pkgdir/var/lib/joan-imsd"
	for f in joan_ims_live.py joan_ims_profiles.py joan_ims_esp.py \
		joan_ims_ipsec.py joan_ims_pco.py joan_ims_register.py \
		joan_ims_ua.py; do
		install -Dm644 "$srcdir/$f" "$pkgdir/usr/lib/joan-imsd/$f"
	done
	install -Dm644 "$srcdir/carrier-profiles.json" \
		"$pkgdir/usr/share/joan-imsd/carrier-profiles.json"
	install -Dm644 "$srcdir/profiles/cmcc-cn.yaml" \
		"$pkgdir/usr/share/joan-imsd/profiles/cmcc-cn.yaml"
	install -Dm644 "$srcdir/tmo-us.yaml" \
		"$pkgdir/usr/share/joan-imsd/profiles/tmo-us.yaml"
}

openrc() {
	install -Dm755 "$srcdir/joan-imsd.initd" "$subpkgdir/etc/init.d/joan-imsd"
}

systemd_unit() {
	pkgdesc="systemd service for joan-imsd"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"

	install -Dm644 "$srcdir/joan-imsd.service" \
		"$subpkgdir/usr/lib/systemd/system/joan-imsd.service"
}

