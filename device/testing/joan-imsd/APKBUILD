# Maintainer: Lance <Gero3977@gmail.com>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=joan-imsd
pkgver=0.1
pkgrel=0
pkgdesc="3GPP IMS SIP UA for LG V30 (joan) VoLTE — AP-side, no vendor blobs"
url="https://github.com/ShapeShifter499/lg-v30-joan-pmos-packages"
arch="noarch"
license="MIT"
depends="python3 qmi-utils modemmanager 81voltd"
subpackages="$pkgname-openrc"
options="!check"
source="
	joan-ims
	joan-imsd.initd
	joan-ims.desktop
	joan_ims_live.py
	joan_ims_esp.py
	joan_ims_ipsec.py
	joan_ims_pco.py
	joan_ims_register.py
	joan_ims_ua.py
	tmo-us.yaml
	"

package() {
	install -Dm755 "$srcdir/joan-ims" "$pkgdir/usr/bin/joan-ims"
	install -Dm644 "$srcdir/joan-ims.desktop" \
		"$pkgdir/usr/share/applications/joan-ims.desktop"
	install -d "$pkgdir/usr/lib/joan-imsd" \
		"$pkgdir/usr/share/joan-imsd/profiles" \
		"$pkgdir/etc/joan-imsd" \
		"$pkgdir/var/lib/joan-imsd"
	for f in joan_ims_live.py joan_ims_esp.py joan_ims_ipsec.py \
		joan_ims_pco.py joan_ims_register.py joan_ims_ua.py; do
		install -Dm644 "$srcdir/$f" "$pkgdir/usr/lib/joan-imsd/$f"
	done
	install -Dm644 "$srcdir/tmo-us.yaml" \
		"$pkgdir/usr/share/joan-imsd/profiles/tmo-us.yaml"
}

openrc() {
	install -Dm755 "$srcdir/joan-imsd.initd" "$subpkgdir/etc/init.d/joan-imsd"
}

