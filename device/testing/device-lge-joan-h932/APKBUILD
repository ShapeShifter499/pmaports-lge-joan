# Reference: <https://postmarketos.org/devicepkg>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=device-lge-joan-h932
pkgdesc="LG V30, T-Mobile H932 only (differently signed firmware)"
pkgver=1
pkgrel=8
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-lge-joan
	firmware-lge-joan
	firmware-lge-joan-h932
	firmware-lge-joan-initramfs
	firmware-qcom-adreno-a530
	lge-joan-volte
	linux-lge-joan
	mkbootimg
	pipewire-alsa
	pipewire-echo-cancel
	pipewire-pulse
	postmarketos-base
	postmarketos-base-ui-audio-backend-pipewire
	soc-qcom
	wireplumber
"
makedepends="devicepkg-dev"
source="deviceinfo
	50-joan-echo-cancel.conf
	phosh-start-timeout.conf
	90-joan-bfq.rules
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Raise Phosh's start timeout; the file's header records the measurement.
	install -Dm644 "$srcdir"/phosh-start-timeout.conf \
		"$pkgdir"/usr/lib/systemd/user/mobi.phosh.Shell.service.d/10-phosh-start-timeout.conf

	# BFQ for the microSD the SD-flavour rootfs lives on
	install -Dm644 "$srcdir"/90-joan-bfq.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-joan-bfq.rules

	# WebRTC noise suppression / echo cancellation on the mic
	install -Dm644 "$srcdir"/50-joan-echo-cancel.conf \
		"$pkgdir"/usr/share/pipewire/pipewire.conf.d/50-joan-echo-cancel.conf
}

