deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_drm="true"
deviceinfo_screen_width="1440"
deviceinfo_screen_height="2880"
deviceinfo_rootfs_image_sector_size="4096"

# Bootloader related
