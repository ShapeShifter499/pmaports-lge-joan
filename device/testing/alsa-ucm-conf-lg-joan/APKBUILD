# Maintainer: Lance <Gero3977@gmail.com>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=alsa-ucm-conf-lg-joan
pkgver=1.0
pkgrel=9
pkgdesc="ALSA UCM profile for the LG V30 (joan) sound card"
url="https://github.com/ShapeShifter499/lg-v30-joan-pmos-packages"
arch="noarch"
license="BSD-3-Clause"
provides="alsa-ucm-conf-lge-joan=$pkgver-r$pkgrel"
replaces="alsa-ucm-conf-lge-joan"
depends="alsa-ucm-conf"
options="!check"
source="
	LGV30.conf
	HiFi.conf
	"

package() {
	# Entry point, named after the card ID: alsa-lib's UCM2 loader looks for
	# ucm2/<CardId>/<CardId>.conf at the TOP level of ucm2, not under a vendor
	# subdirectory (alsa-lib does not find ucm2/Qualcomm/LGV30). Our card ID is
	# LGV30 (no hyphen), which does not match the card long name LG-V30 that the
	# old conf.d alias was named after.
	install -Dm644 "$srcdir/LGV30.conf" \
		"$pkgdir/usr/share/alsa/ucm2/LGV30/LGV30.conf"

	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/LGV30/HiFi.conf"
}

sha512sums="
bccf563f1e5ab0e59ab8ef645acb0ff16e8f7a836e0660b186362a6f728be07937705f1799969ae4295067bff516832df9a2710664003e239da608181479afba  LGV30.conf
a0bfdaa0963b313968449d8c8f8642a5af1605ce5823746dc185f7d5ceb3481df818e597482efaa37cfdeed64e4ed3db155467859d225b322dc86c548f0ae49f  HiFi.conf
"
