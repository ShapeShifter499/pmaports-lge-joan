# Maintainer: Lance <Gero3977@gmail.com>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=alsa-ucm-conf-lg-joan
pkgver=1.0
pkgrel=12
pkgdesc="ALSA UCM profile for the LG V30 (joan) sound card"
url="https://github.com/ShapeShifter499/lg-v30-joan-pmos-packages"
arch="noarch"
license="BSD-3-Clause"
provides="alsa-ucm-conf-lge-joan=$pkgver-r$pkgrel"
replaces="alsa-ucm-conf-lge-joan"
depends="alsa-ucm-conf"
options="!check"
source="
	joan.conf
	HiFi.conf
	"

package() {
	# Same layout as the sdm845 phones: the profile lives under a vendor
	# directory and conf.d/<card driver>/<card long name>.conf points at it.
	# alsa-lib probes conf.d/sdm845/LG-V30.conf for this card (driver
	# "sdm845", long name "LG-V30").
	install -Dm644 "$srcdir"/joan.conf \
		"$pkgdir"/usr/share/alsa/ucm2/LG/joan/joan.conf
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/LG/joan/HiFi.conf

	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sdm845
	ln -s ../../LG/joan/joan.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sdm845/LG-V30.conf
}

sha512sums="
7c97c24daee50b0e129e88e3d336b9913b253c9b305535b91e3d9511d75895075241012885391e800872dde43a21b56a751d3dc584e2b75e68bf2d59ac09d10b  joan.conf
25428a6d75691d69c6706aee2f0eca1a1afd6ec5ae0467066db207a4451df7a0e031a004edb33cf2f7c6e375bd6e49b6a7a5f76122783eefb52b5ba61f8b71ea  HiFi.conf
"
