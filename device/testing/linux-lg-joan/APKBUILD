# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config: arm64 defconfig trimmed to ARCH_QCOM (as pmOS's sdm845
# kernel), with USB gadget, pstore, display/backlight and Qualcomm
# GPU/UFS/SDHCI/QMP-PHY drivers built in, and pmOS's kconfigcheck
# "community" requirements applied. The one gap is "hardening": CFI needs a
# Clang/LLVM build, which this kernel is not (yet).
maintainer="Lance <Gero3977@gmail.com>"
_flavor="lg-joan"
_dtb="qcom/msm8998-lg-joan"   # must match deviceinfo_dtb
pkgname=linux-$_flavor
pkgver=7.3.0_rc6
pkgrel=11
_commit=737cbff165a6c3d4b5dc77c9baa1f590a96e86bd
pkgdesc="Mainline kernel for the LG V30 (joan)"
arch="aarch64"
_carch="arm64"
_config="config-$_flavor.$arch"
url="https://github.com/ShapeShifter499/linux-lg-v30-joan"
license="GPL-2.0-only"
provides="linux-lge-joan=$pkgver-r$pkgrel"
replaces="linux-lge-joan"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-accessibility
	pmb:kconfigcheck-community_various
	pmb:kconfigcheck-containers
	pmb:kconfigcheck-debug
	pmb:kconfigcheck-filesystems
	pmb:kconfigcheck-immutable
	pmb:kconfigcheck-input
	pmb:kconfigcheck-iwd
	pmb:kconfigcheck-netboot
	pmb:kconfigcheck-netmount
	pmb:kconfigcheck-nftables
	pmb:kconfigcheck-usb
	pmb:kconfigcheck-usb_gadgets
	pmb:kconfigcheck-waydroid
	pmb:kconfigcheck-wine
	pmb:kconfigcheck-wireguard
	pmb:kconfigcheck-zram
"
makedepends="
	bash
	bc
	bison
	elfutils-dev
	findutils
	flex
	linux-headers
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	xz
	zlib-dev
"

source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	$_config
"
builddir="$srcdir/linux-lg-v30-joan-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor"
}

package() {
	mkdir -p "$pkgdir/boot"

	make zinstall modules_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir/boot" \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1

	# Only joan's DTB, not dtbs_install's whole arm64 set.  The boot
	# partition is 226 MiB and dtbs_install writes 1841 files into it,
	# which leaves too little headroom to stage an upgrade's new copies
	# alongside the old ones: apk then fails mid-transaction with
	# "No space left on device" and the package is left unchanged.
	install -Dm644 "$builddir/arch/$_carch/boot/dts/${_dtb}.dtb" \
		"$pkgdir/boot/dtbs/${_dtb}.dtb"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

sha512sums="
