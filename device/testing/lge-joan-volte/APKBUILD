# Maintainer: Lance <Gero3977@gmail.com>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=lge-joan-volte
pkgver=0.1
pkgrel=2
pkgdesc="LG V30 (joan) first-boot VoLTE stack: MM, 81voltd, Calls, IMS UA"
url="https://github.com/ShapeShifter499/lg-v30-joan-pmos-packages"
arch="noarch"
license="MIT"
subpackages="$pkgname-systemd:systemd_units"
depends="
	81voltd
	calls
	callaudiod
	joan-imsd
	modemmanager
	rmtfs
	"
source="
	80-device-lge-joan.preset
	"
options="!check"

package() {
	mkdir -p "$pkgdir"
}

systemd_units() {
	pkgdesc="systemd units and preset for the joan modem and IMS stack"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	depends="81voltd-systemd rmtfs-systemd"

	install -Dm644 "$srcdir/80-device-lge-joan.preset" \
		"$subpkgdir/usr/lib/systemd/system-preset/80-device-lge-joan.preset"
}

sha512sums="
