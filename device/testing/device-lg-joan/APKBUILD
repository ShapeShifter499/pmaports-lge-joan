build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Raise Phosh's start timeout; the file's header records the measurement.
	install -Dm644 "$srcdir"/phosh-start-timeout.conf \
		"$pkgdir"/usr/lib/systemd/user/mobi.phosh.Shell.service.d/10-phosh-start-timeout.conf

	# BFQ for the microSD the SD-flavour rootfs lives on
	install -Dm644 "$srcdir"/90-joan-bfq.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-joan-bfq.rules

	# Keep GStreamer away from the Venus H.264 encoder until its EOS fix
	# lands (see the file header; the SoC resets when the firmware asserts).
	install -Dm644 "$srcdir"/60-joan-gst-rank.conf \
		"$pkgdir"/etc/environment.d/60-joan-gst-rank.conf

	# Lock-gated display scale: scale 2 while locked, native when unlocked.
	install -Dm755 "$srcdir"/joan-lock-scale \
		"$pkgdir"/usr/libexec/joan-lock-scale
	install -Dm644 "$srcdir"/joan-lock-scale.service \
		"$pkgdir"/usr/lib/systemd/user/joan-lock-scale.service
	mkdir -p "$pkgdir"/etc/systemd/user/graphical-session.target.wants
	ln -s /usr/lib/systemd/user/joan-lock-scale.service \
		"$pkgdir"/etc/systemd/user/graphical-session.target.wants/joan-lock-scale.service

	# Default apps for hardware the V30 has, beyond the UI's own set
	# (calls, chatty and snapshot come with phosh): a voice recorder, a
	# per-application volume panel, neard plus the NFC Tags reader/writer
	# for the PN547 NFC controller, and FM Radio for the WCN3990 tuner.
	install -Dm644 "$srcdir"/90-lg-joan.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-lg-joan.preset
	install -Dm644 "$srcdir"/org.neard.service \
		"$pkgdir"/usr/share/dbus-1/system-services/org.neard.service

	# Let feedbackd drive the DW7800 vibration motor
	install -Dm644 "$srcdir"/73-joan-feedbackd.rules \
		"$pkgdir"/usr/lib/udev/rules.d/73-joan-feedbackd.rules

	# Megapixels: second camera app that drives the CAMSS raw pipeline
	# directly (no GStreamer-GL in-process). Config matches the live
	# topology: imx351/s5k3m3/hi553 on their own csid/ispif/vfe lanes.
	install -Dm644 "$srcdir"/megapixels-lg-joan.conf \
		"$pkgdir"/usr/share/megapixels/config/lg,joan.conf

	# WebRTC noise suppression / echo cancellation on the mic
	install -Dm644 "$srcdir"/50-joan-echo-cancel.conf \
		"$pkgdir"/usr/share/pipewire/pipewire.conf.d/50-joan-echo-cancel.conf

	# WirePlumber ALSA settings measured on this device (see each file's
	# header): the sink drives the graph, and the q6asm frontends get
	# IRQ-driven, non-mmap periods within their size limits.
	install -Dm644 -t "$pkgdir"/usr/share/wireplumber/wireplumber.conf.d \
		"$srcdir"/53-joan-driver-priority.conf \
		"$srcdir"/54-joan-no-mmap.conf
}

