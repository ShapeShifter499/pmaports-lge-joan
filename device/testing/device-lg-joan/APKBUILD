# Reference: <https://postmarketos.org/devicepkg>
maintainer="Lance <Gero3977@gmail.com>"
pkgname=device-lg-joan
pkgdesc="LG V30 (H930, US998, H932PR and other non-H932)"
pkgver=1
pkgrel=37
url="https://postmarketos.org"
license="MIT"
provides="device-lge-joan=$pkgver-r$pkgrel"
replaces="device-lge-joan"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-lg-joan
	bootmac
	firmware-lg-joan
	firmware-lg-joan-h930
	firmware-lg-joan-initramfs
	firmware-qcom-adreno-a530
	fm-radio
	gnome-sound-recorder
	libsecret
	joan-adsp-watchdog
	lg-joan-volte
	lg-joan-cellular-data
	linux-lg-joan>=7.3.0_rc6-r9
	megapixels
	mkbootimg
	neard
	nfc-tags
	pipewire-alsa
	pipewire-pulse
	postmarketos-base
	postmarketos-base-ui-audio-backend-pipewire
	postmarketos-usb-moded-default-profile-developer
	pwvucontrol
	sns-reg
	soc-qcom
	wireplumber
"
makedepends="devicepkg-dev"
subpackages="$pkgname-waydroid"
source="deviceinfo
	53-joan-driver-priority.conf
	54-joan-no-mmap.conf
	55-joan-camera-names.conf
	joan-lock-scale
	joan-lock-scale.service
	phosh-start-timeout.conf
	90-joan-bfq.rules
	joan-dconf-profile
	00-joan-performance
	60-joan-gst-rank.conf
	90-lg-joan.preset
	73-joan-feedbackd.rules
	org.neard.service
	megapixels-lg-joan.conf
	registry.conf
	91-joan-usb-runtime-pm.rules
	joan-hw-video.js
	joan-volte-account
	joan-volte-account.service
	90_joan-calls.gschema.override
	90_joan-brightness.gschema.override
	30-lg-joan.conf
	
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Raise Phosh's start timeout; the file's header records the measurement.
	install -Dm644 "$srcdir"/phosh-start-timeout.conf \
		"$pkgdir"/usr/lib/systemd/user/mobi.phosh.Shell.service.d/10-phosh-start-timeout.conf

	# BFQ for the microSD the SD-flavour rootfs lives on
	install -Dm644 "$srcdir"/90-joan-bfq.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-joan-bfq.rules

	# Let the USB controller suspend, and release DDR, after an unplug
	install -Dm644 "$srcdir"/91-joan-usb-runtime-pm.rules \
		"$pkgdir"/usr/lib/udev/rules.d/91-joan-usb-runtime-pm.rules

	# Kernel options for this device, added to postmarketOS's own
	# (quiet, splash) rather than replacing them
	install -Dm644 "$srcdir"/30-lg-joan.conf \
		"$pkgdir"/usr/lib/kernel-cmdline.d/30-lg-joan.conf

	# First login: the VoLTE account in Calls, and Calls prefers that line
	install -Dm644 "$srcdir"/90_joan-calls.gschema.override \
		"$pkgdir"/usr/share/glib-2.0/schemas/90_joan-calls.gschema.override
	install -Dm644 "$srcdir"/90_joan-brightness.gschema.override \
		"$pkgdir"/usr/share/glib-2.0/schemas/90_joan-brightness.gschema.override
	install -Dm755 "$srcdir"/joan-volte-account \
		"$pkgdir"/usr/libexec/joan-volte-account
	install -Dm644 "$srcdir"/joan-volte-account.service \
		"$pkgdir"/usr/lib/systemd/user/joan-volte-account.service
	mkdir -p "$pkgdir"/etc/systemd/user/graphical-session.target.wants
	ln -s /usr/lib/systemd/user/joan-volte-account.service \
		"$pkgdir"/etc/systemd/user/graphical-session.target.wants/joan-volte-account.service

	# Venus hardware video decode in Firefox
	install -Dm644 "$srcdir"/joan-hw-video.js \
		"$pkgdir"/usr/lib/firefox/defaults/pref/joan-hw-video.js

	# Keep GStreamer away from the Venus H.264 encoder until its EOS fix
	# lands (see the file header; the SoC resets when the firmware asserts).
	install -Dm644 "$srcdir"/60-joan-gst-rank.conf \
		"$pkgdir"/etc/environment.d/60-joan-gst-rank.conf

	# Lock-gated display scale: scale 2 while locked, native when unlocked.
	install -Dm755 "$srcdir"/joan-lock-scale \
		"$pkgdir"/usr/libexec/joan-lock-scale
	install -Dm644 "$srcdir"/joan-lock-scale.service \
		"$pkgdir"/usr/lib/systemd/user/joan-lock-scale.service
	mkdir -p "$pkgdir"/etc/systemd/user/graphical-session.target.wants
	ln -s /usr/lib/systemd/user/joan-lock-scale.service \
		"$pkgdir"/etc/systemd/user/graphical-session.target.wants/joan-lock-scale.service

	# Default apps for hardware the V30 has, beyond the UI's own set
	# (calls, chatty and snapshot come with phosh): a voice recorder, a
	# per-application volume panel, neard plus the NFC Tags reader/writer
	# for the PN547 NFC controller, and FM Radio for the WCN3990 tuner.
	install -Dm644 "$srcdir"/90-lg-joan.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-lg-joan.preset
	install -Dm644 "$srcdir"/org.neard.service \
		"$pkgdir"/usr/share/dbus-1/system-services/org.neard.service

	# Feed SLPI the LG sensor identities, buses, rails and baseline calibration.
	install -Dm644 "$srcdir"/registry.conf \
		"$pkgdir"/etc/sns-reg.d/registry.conf

	# Let feedbackd drive the DW7800 vibration motor
	install -Dm644 "$srcdir"/73-joan-feedbackd.rules \
		"$pkgdir"/usr/lib/udev/rules.d/73-joan-feedbackd.rules

	# Megapixels: second camera app that drives the CAMSS raw pipeline
	# directly (no GStreamer-GL in-process). Config matches the live
	# topology: imx351/s5k3m3/hi553 on their own csid/ispif/vfe lanes.
	install -Dm644 "$srcdir"/megapixels-lg-joan.conf \
		"$pkgdir"/usr/share/megapixels/config/lg,joan.conf

	# WirePlumber ALSA settings measured on this device (see each file's
	# header): the sink drives the graph, and the q6asm frontends get
	# IRQ-driven, non-mmap periods within their size limits.
	install -Dm644 -t "$pkgdir"/usr/share/wireplumber/wireplumber.conf.d \
		"$srcdir"/53-joan-driver-priority.conf \
		"$srcdir"/54-joan-no-mmap.conf \
		"$srcdir"/55-joan-camera-names.conf
}

waydroid() {
	# Installed automatically alongside waydroid. The default nftables
	# policy blocks waydroid0, which leaves Android apps with no network.
	pkgdesc="Waydroid support for the LG V30"
	install_if="$pkgname=$pkgver-r$pkgrel waydroid"
	depends="waydroid-nftrules"
	mkdir -p "$subpkgdir"/etc/nftables.d
	ln -s /usr/share/nftables.avail/51_waydroid.nft \
		"$subpkgdir"/etc/nftables.d/51_waydroid.nft
}

