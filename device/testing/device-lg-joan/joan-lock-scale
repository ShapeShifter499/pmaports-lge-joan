#!/bin/sh
# Lock-gated output scale: the lockscreen/OSK are GTK3 CPU-rasterized at
# 4.15 Mpixel; drop the output to scale 2 while locked (quarter the Cairo
# work, upscaled by the GPU in phoc) and restore native sharpness on unlock.
# Needs the session env; run as a systemd --user unit.
SCALE_LOCKED=2
SCALE_UNLOCKED=1
OUTPUT=DSI-1

export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
randr() {
	wlr-randr --output "$OUTPUT" --scale "$1" 2>/dev/null
}

randr "$SCALE_UNLOCKED"

dbus-monitor --session \
"type='signal',interface='org.gnome.ScreenSaver',member='ActiveChanged'" 2>/dev/null |
while read -r line; do
	case "$line" in
	*boolean*)
		case "$line" in
		*true*)
			randr "$SCALE_LOCKED"
			;;
		*false*)
			randr "$SCALE_UNLOCKED"
			;;
		esac
		;;
	esac
done
